# Cargo workspace 根：只管成员清单与公共配置，不放任何代码。
#
# 为什么拆 workspace（见 docs/design.md §4.2 / §9）：
#   - crates/gba-core  —— 模拟核心库，禁止依赖任何 UI/窗口/音频库，
#                         保证它能脱离界面独立构建、测试（CI 无屏幕也能跑）；
#   - apps/desktop     —— M5 加入的 Tauri 桌面应用，Tauri 依赖只进那里。
[workspace]
resolver = "2"
members = ["crates/gba-core"]

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT"

[profile.release]
# 模拟器是计算密集型程序（每秒要"手工执行"数百万条指令），
# 发布构建按 docs/design.md §12 激进优化。调试期不生效，不影响编译速度。
lto = true
codegen-units = 1
